body { -webkit-box-align: center; place-items: center; display: flex; font-family: Inter, system-ui; height: 100dvh; margin: 0px; overflow: hidden; overscroll-behavior: contain; }

#razorpay-checkout-v2-container.loaded { opacity: 1; transition: 0.3s 0.3s; }

a, button, input, select, textarea { -webkit-tap-highlight-color: transparent; }

@media (max-aspect-ratio: 9 / 16), (max-width: 490px) {
  #razorpay-checkout-v2-container { border-radius: 0px; max-height: 100%; max-width: 100%; }
  #razorpay-checkout-v2-failed { border-bottom-left-radius: 0px; border-bottom-right-radius: 0px; margin-bottom: 0px; }
  #bottom-cta ~ #contact-submit { display: none; }
}

@media (min-width: 1000px) {
  #main-container { margin: 50px 10px 10px 50px; opacity: 0; transition: opacity 0.4s 0.1s, margin 0.6s 0.2s; }
  #razorpay-checkout-v2-container.loaded #main-container { margin: 0px; opacity: 1; }
}

@media (max-height: 359px) {
  #account-strip, #merchant-identity, #overview-container { display: none; }
  #main-container { border-radius: 0px; }
  #razorpay-checkout-v2-container { border-radius: 0px; overflow: auto; }
}

@media (max-height: 200px) {
  #main-container, #razorpay-checkout-v2-container > div { display: block; }
  #bottom-container { position: relative; }
}

