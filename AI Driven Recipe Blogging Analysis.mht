.FOOTER { width: 100%; height: 100%; margin: auto; padding: 0 var(--mood-padding-left) 0 var(--mood-padding-right); box-sizing: border-box; position: absolute; top: 0px; overflow: hidden; bottom: var(--transition-element); background-color: rgba(0, 0, 0, 0); pointer-events: none; z-index: 99; color: var(--tertiary-color) !important; }

.FOOTER #FOOTER_SLIDE_NUMBER_HOLDER { min-width: 34px; width: auto; max-width: 40px; height: 34px; box-sizing: border-box; margin: auto; display: flex; align-items: center; justify-content: center; position: absolute; color: inherit; z-index: 1; }

.FOOTER #FOOTER_BG { position: absolute; inset: 0px; }

.FOOTER #FOOTER_BG, .FOOTER #FOOTER_DIVIDER_LINE { position: absolute; }

.FOOTER #FOOTER_BG.borderleftdashed { border-left: 2px dashed; }

.FOOTER #FOOTER_BG.borderrightdashed { border-right: 2px dashed; }

.FOOTER #FOOTER_BG.bordertopdashed { border-top: 2px dashed; }

.FOOTER #FOOTER_BG.borderbottomdashed { border-bottom: 2px dashed; }

.FOOTER #FOOTER_BG.borderalldashed { border: 2px dashed; }

.FOOTER #FOOTER_BG.borderleftsolid, .FOOTER #FOOTER_BG.borderleft { border-left: 2px solid; }

.FOOTER #FOOTER_BG.borderrightsolid, .FOOTER #FOOTER_BG.borderright { border-right: 2px solid; }

.FOOTER #FOOTER_BG.bordertopsolid, .FOOTER #FOOTER_BG.bordertop { border-top: 2px solid; }

.FOOTER #FOOTER_BG.borderbottomsolid, .FOOTER #FOOTER_BG.borderbottom { border-bottom: 2px solid; }

.FOOTER #FOOTER_BG.borderallsolid { border: 2px solid; }

.FOOTER #FOOTER_BG.bordertheme { border-color: var(--item1-color); }

.FOOTER #FOOTER_BG.bordersecondary { border-color: var(--secondary-color); }

.FOOTER #FOOTER_BG.bordertertiary { border-color: var(--tertiary-color); }

.FOOTER #FOOTER_BG.all { border: 2px solid; }

.FOOTER #FOOTER_BG.bgleft { right: unset; left: 0px; }

.FOOTER #FOOTER_BG.bgright { right: 0px; left: unset; }

.FOOTER #FOOTER_BG.bgbottom { top: unset; bottom: 0px; }

.FOOTER #FOOTER_BG.bgtop { top: 0px; bottom: unset; }

.FOOTER #FOOTER_MESSAGE { min-width: 120px; max-width: 100%; margin: auto; position: absolute; color: inherit; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

.FOOTER #FOOTER_LOGO { max-width: 240px; width: 100%; height: 30px; margin: auto; position: absolute; overflow: hidden; }

.FOOTER #FOOTER_LOGO #FOOTER_LOGO_IMG { height: 100%; width: auto; }

#FOOTER .lefttop { left: 0px; top: 0px; text-align: left; justify-content: flex-start; }

#FOOTER .righttop { right: 0px; top: 0px; text-align: right; justify-content: flex-end; }

#FOOTER .bottomleft { text-align: left; left: 0px; bottom: 0px; }

#FOOTER .bottomleft img { float: left; }

#FOOTER .bottomright { text-align: right; right: 0px; bottom: 0px; }

#FOOTER .bottomright img { float: right; }

#FOOTER .bottomcenter { text-align: center; left: 0px; right: 0px; bottom: 0px; margin-left: auto !important; margin-right: auto !important; }

#FOOTER .bottomcenter img { margin: auto; }

#FOOTER .topleft { text-align: left; left: 0px; top: 0px; }

#FOOTER .topleft img { float: left; }

#FOOTER .topright { text-align: right; right: 0px; top: 0px; }

#FOOTER .topright img { float: right; }

#FOOTER .topcenter { text-align: center; left: 0px; right: 0px; top: 0px; margin: auto !important; }

#FOOTER .topcenter img { margin: auto; }

#FOOTER .leftcenter { text-align: center; bottom: 0px; top: 0px; }

#FOOTER .leftcenter img { float: unset; }

#FOOTER .rightcenter { text-align: center; bottom: 0px; top: 0px; }

#FOOTER .rightcenter img { float: unset; }

#FOOTER .vertical-leftcenter { width: 400px; min-width: 400px; max-width: 400px; text-align: center; bottom: 0px; left: -188px; top: 0px; right: unset; transform: rotate(-90deg); transform-origin: center center; margin-top: auto !important; margin-bottom: auto !important; }

#FOOTER .vertical-leftcenter img { margin: auto; }

#FOOTER .vertical-rightcenter { width: 400px; min-width: 400px; max-width: 400px; text-align: center; bottom: 0px; right: -188px; top: 0px; transform: rotate(90deg); transform-origin: center center; margin-top: auto !important; margin-bottom: auto !important; }

#FOOTER .vertical-rightcenter img { margin: auto; }

#FOOTER .vertical-topleft { width: 100%; max-width: 480px; position: absolute; left: -230px; top: 230px; text-align: right; transform: rotate(270deg) !important; transform-origin: center center !important; }

#FOOTER .vertical-topleft img { float: right; }

#FOOTER .vertical-topright { text-align: left; left: calc(100% - 12px); top: -12px; transform: rotate(90deg); transform-origin: left center; bottom: unset !important; }

#FOOTER .vertical-topright img { float: left; }

#FOOTER .vertical-bottomleft { left: 12px; bottom: -12px; transform: rotate(-90deg); transform-origin: left center; top: unset !important; }

#FOOTER .vertical-bottomleft img { float: unset; }

#FOOTER .vertical-bottomright { right: 12px; bottom: -12px; transform: rotate(90deg); transform-origin: right center; top: unset !important; }

#FOOTER .vertical-bottomright img { float: right; }

#FOOTER #FOOTER_SLIDE_NUMBER_HOLDER.vertical-topleft { transform: rotate(0deg); transform-origin: unset; top: 0px !important; }

#FOOTER #FOOTER_SLIDE_NUMBER_HOLDER.vertical-topright { transform: rotate(0deg); transform-origin: unset; top: 0px !important; }

#FOOTER #FOOTER_SLIDE_NUMBER_HOLDER.vertical-bottomleft { transform: rotate(0deg); transform-origin: unset; }

#FOOTER #FOOTER_SLIDE_NUMBER_HOLDER.vertical-bottomright { transform: rotate(0deg); transform-origin: unset; }

#FOOTER #FOOTER_MESSAGE.vertical-topleft { max-width: 480px; }

#FOOTER #FOOTER_MESSAGE.vertical-topright { max-width: 480px; }

#FOOTER #FOOTER_MESSAGE.vertical-bottomleft { max-width: 480px; }

#FOOTER #FOOTER_MESSAGE.vertical-bottomright { max-width: 480px; }

#FOOTER #FOOTER_SLIDE_NUMBER_HOLDER.roundedoutline { border-radius: 10px; }

#FOOTER #FOOTER_SLIDE_NUMBER_HOLDER.circleoutline { border-radius: 50%; }

#FOOTER #FOOTER_SLIDE_NUMBER_HOLDER.roundedsolid { border-radius: 10px; }

#FOOTER #FOOTER_SLIDE_NUMBER_HOLDER.circlesolid { border-radius: 50%; }

