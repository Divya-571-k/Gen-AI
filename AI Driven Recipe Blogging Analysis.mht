* { }

.PTSerif { font-family: "PT Serif"; }

.InterFont { font-family: Inter; }

span[contenteditable="plaintext-only"]:empty::before { content: attr(data-prompt); color: rgb(198, 198, 198); }

span.lightText[contenteditable="plaintext-only"]:empty::before { content: attr(data-prompt); color: rgba(255, 255, 255, 0.3); }

.bg-pattern { opacity: 0.15; background-image: repeating-linear-gradient(45deg, rgb(0, 0, 0) 25%, transparent 25%, transparent 75%, rgb(0, 0, 0) 0%, rgb(0, 0, 0)), repeating-linear-gradient(45deg, rgb(255, 193, 7) 25%, rgb(255, 255, 255) 25%, rgb(255, 255, 255) 75%, rgb(0, 0, 0) 75%, rgb(0, 0, 0)); background-position: 0px 0px, 5px 5px; background-size: 10px 10px; }

.mainOpacity { animation: 2.9s ease 0s 1 normal forwards running opacityanimation; }

@keyframes opacityanimation { 
  0% { opacity: 0; }
  100% { opacity: 1; }
}

.zoomInAnimation { animation: 0.2s ease 0s 1 normal forwards running zoomInAnimation; }

@keyframes zoomInAnimation { 
  0% { transform: scale(0.5); opacity: 0; }
  100% { transform: scale(1); opacity: 1; }
}

.bottomToTop { animation: 1s ease 0s 1 normal forwards running bottomToTop; }

.bottomToTopFast { animation: 0.5s ease 0s 1 normal forwards running bottomToTop; }

@keyframes bottomToTop { 
